    <worksheet name='RU_KPI_Avg_Occupied_Beds'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Book Antiqua' fontsize='9'>AVG OCCUPIED BEDS</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Patient_Admissions_Data (hospital_final_dataset)' name='federated.187v7rn0gtp0m61ab2wqg09r272q' />
          </datasources>
          <datasource-dependencies datasource='federated.187v7rn0gtp0m61ab2wqg09r272q'>
            <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
            <column caption='RU_KPI_Avg_Occupied_Val' datatype='integer' name='[Calculation_0666616212221953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : SUM({ FIXED [Department_Name] : MAX(&#13;&#10;  CASE [Department_Name]&#13;&#10;  WHEN &quot;Surgery&quot; THEN 65&#13;&#10;  WHEN &quot;Emergency&quot; THEN 55&#13;&#10;  WHEN &quot;Pediatrics&quot; THEN 44&#13;&#10;  WHEN &quot;Internal Medicine&quot; THEN 41&#13;&#10;  WHEN &quot;Orthopedics&quot; THEN 29&#13;&#10;  WHEN &quot;ICU&quot; THEN 30&#13;&#10;  ELSE 0&#13;&#10;  END&#13;&#10;) }) }' />
            </column>
            <column caption='RU_Occupied_YoY_Delta_%' datatype='real' name='[Calculation_0666616214183939]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1343912937381907] - [Calculation_1343912937467924]) / [Calculation_1343912937467924]' />
            </column>
            <column caption='RU_Occupied_Delta_Pos' datatype='string' name='[Calculation_0666616214384644]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0666616214183939] &gt;= 0 THEN &quot;▲ &quot; + STR(ROUND([Calculation_0666616214183939] * 100, 1)) + &quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='RU_Occupied_Delta_Neg' datatype='string' name='[Calculation_0666616214519813]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0666616214183939] &lt; 0 THEN &quot;▼ &quot; + STR(ROUND(ABS([Calculation_0666616214183939]) * 100, 1)) + &quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='CY_Occupancy_Rate' datatype='real' name='[Calculation_1343912937381907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF YEAR([Admission_Date]) = {MAX(YEAR([Admission_Date]))} THEN [Dept_Occupancy_Rate] END)' />
            </column>
            <column caption='PY_Occupancy_Rate' datatype='real' name='[Calculation_1343912937467924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF YEAR([Admission_Date]) = {MAX(YEAR([Admission_Date])) - 1} THEN [Dept_Occupancy_Rate] END)' />
            </column>
            <column caption='Department Name' datatype='string' name='[Department_Name]' role='dimension' type='nominal' />
            <column caption='Dept Occupancy Rate' datatype='real' name='[Dept_Occupancy_Rate]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0666616212221953]' derivation='Sum' name='[sum:Calculation_0666616212221953:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0666616214384644]' derivation='User' name='[usr:Calculation_0666616214384644:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0666616214519813]' derivation='User' name='[usr:Calculation_0666616214519813:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
