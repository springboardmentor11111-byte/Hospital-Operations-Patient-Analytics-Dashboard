      <table>
        <view>
          <datasources>
            <datasource caption='Patient_Admissions_Data (hospital_final_dataset)' name='federated.187v7rn0gtp0m61ab2wqg09r272q' />
          </datasources>
          <datasource-dependencies datasource='federated.187v7rn0gtp0m61ab2wqg09r272q'>
            <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
            <column caption='CY_ALOS' datatype='real' name='[Calculation_1343912920281097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF YEAR([Admission_Date]) = {MAX(YEAR([Admission_Date]))} THEN [Length_of_Stay] END)' />
            </column>
            <column caption='PY_ALOS' datatype='real' name='[Calculation_1343912920621066]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF YEAR([Admission_Date]) = {MAX(YEAR([Admission_Date])) - 1} THEN [Length_of_Stay] END)' />
            </column>
            <column caption='ALOS_YoY_Delta_Days' datatype='real' name='[Calculation_1343912920825867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1343912920281097] - [Calculation_1343912920621066]' />
            </column>
            <column caption='ALOS_Delta_Pos' datatype='real' default-format='*▲ 0.00d' name='[Calculation_1343912921014284]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1343912920825867] &gt;= 0 THEN [Calculation_1343912920825867] END' />
            </column>
            <column caption='ALOS_Delta_Neg' datatype='real' default-format='*▼ 0.00d' name='[Calculation_1343912921145357]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1343912920825867] &lt; 0 THEN [Calculation_1343912920825867] END' />
            </column>
            <column caption='Length of Stay' datatype='integer' name='[Length_of_Stay]' role='measure' type='quantitative' />
            <column-instance column='[Length_of_Stay]' derivation='Avg' name='[avg:Length_of_Stay:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1343912921014284]' derivation='User' name='[usr:Calculation_1343912921014284:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1343912921145357]' derivation='User' name='[usr:Calculation_1343912921145357:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
