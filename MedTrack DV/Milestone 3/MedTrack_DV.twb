      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Book Antiqua' fontsize='12'>30-Day Readmission Rate vs. 75% Benchmark</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Book Antiqua' fontsize='9'>Department Comparison</run>
