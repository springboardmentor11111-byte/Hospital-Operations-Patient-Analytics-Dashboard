      <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
      <column caption='Bed Utilization Rate' datatype='real' name='[Bed_Utilization_Rate]' role='measure' type='quantitative' />
      <column caption='RU_Bed_Capacity' datatype='integer' default-format='c#,##0' name='[Calculation_0356553675157505]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Department_Name] : MAX(&#13;&#10;  CASE [Department_Name]&#13;&#10;  WHEN &quot;Surgery&quot; THEN 95&#13;&#10;  WHEN &quot;Emergency&quot; THEN 78&#13;&#10;  WHEN &quot;Pediatrics&quot; THEN 74&#13;&#10;  WHEN &quot;Internal Medicine&quot; THEN 68&#13;&#10;  WHEN &quot;Orthopedics&quot; THEN 52&#13;&#10;  WHEN &quot;ICU&quot; THEN 38&#13;&#10;  ELSE 0&#13;&#10;  END&#13;&#10;)}' />
      </column>
      <column caption='RU_Avg_Occupied_Beds' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0356553675374594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Department_Name] : MAX(&#13;&#10;  CASE [Department_Name]&#13;&#10;  WHEN &quot;Surgery&quot; THEN 65&#13;&#10;  WHEN &quot;Emergency&quot; THEN 55&#13;&#10;  WHEN &quot;Pediatrics&quot; THEN 44&#13;&#10;  WHEN &quot;Internal Medicine&quot; THEN 41&#13;&#10;  WHEN &quot;Orthopedics&quot; THEN 29&#13;&#10;  WHEN &quot;ICU&quot; THEN 30&#13;&#10;  ELSE 0&#13;&#10;  END&#13;&#10;)}' />
      </column>
      <column caption='RU_Projected_Occupancy' datatype='real' default-format='p0.00%' name='[Calculation_0356553675575299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0.6386 * (1 + [Parameters].[Parameter 0356553674072064])' />
      </column>
      <column caption='RU_Projected_ICU_Occupancy' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_0356553675890692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(30 / 38) * (1 + [Parameters].[Parameter 0356553674072064])' />
      </column>
      <column caption='KPI_Growth_Inpatients' datatype='real' default-format='*▲ 0.0%;▼ 0.0%;0.0%' name='[Calculation_0424171832295424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(COUNT([Patient_ID])) - LOOKUP(ZN(COUNT([Patient_ID])), -1)) / ABS(LOOKUP(ZN(COUNT([Patient_ID])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Inpatient_Growth_Latest' datatype='real' default-format='*▲ 0.0%;▼ 0.0%;0.0%' name='[Calculation_0424171837980673]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_MAX(IF LAST() = 0 THEN [Calculation_0424171832295424] END)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI_Total_Inpatients' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0424171839041538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='TOTAL(COUNT([Patient_ID]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI_Peak_Month_Volume' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0424171845246979]' role='measure' type='quantitative'>
