    <worksheet name='RU_KPI_Hospital_Bed_Util'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Book Antiqua' fontsize='9'>HOSPITAL BED UTILIZATION</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Patient_Admissions_Data (hospital_final_dataset)' name='federated.187v7rn0gtp0m61ab2wqg09r272q' />
          </datasources>
          <datasource-dependencies datasource='federated.187v7rn0gtp0m61ab2wqg09r272q'>
            <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
            <column caption='Bed Utilization Rate' datatype='real' name='[Bed_Utilization_Rate]' role='measure' type='quantitative' />
            <column caption='RU_Bed_Util_YoY_Delta_%' datatype='real' name='[Calculation_0666616230871046]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1343912938962968] - [Calculation_1343912939081753]) / [Calculation_1343912939081753]' />
            </column>
            <column caption='RU_Bed_Util_Delta_Pos' datatype='string' name='[Calculation_0666616231096327]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0666616230871046] &gt;= 0 THEN &quot;▲ &quot; + STR(ROUND([Calculation_0666616230871046] * 100, 1)) + &quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='RU_Bed_Util_Delta_Neg' datatype='string' name='[Calculation_0666616231235592]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0666616230871046] &lt; 0 THEN &quot;▼ &quot; + STR(ROUND(ABS([Calculation_0666616230871046]) * 100, 1)) + &quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='CY_Bed_Utilization' datatype='real' name='[Calculation_1343912938962968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF YEAR([Admission_Date]) = {MAX(YEAR([Admission_Date]))} THEN [Bed_Utilization_Rate] END)' />
            </column>
            <column caption='PY_Bed_Utilization' datatype='real' name='[Calculation_1343912939081753]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF YEAR([Admission_Date]) = {MAX(YEAR([Admission_Date])) - 1} THEN [Bed_Utilization_Rate] END)' />
            </column>
            <column-instance column='[Calculation_0666616231096327]' derivation='User' name='[usr:Calculation_0666616231096327:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0666616231235592]' derivation='User' name='[usr:Calculation_0666616231235592:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1343912938962968]' derivation='User' name='[usr:Calculation_1343912938962968:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
