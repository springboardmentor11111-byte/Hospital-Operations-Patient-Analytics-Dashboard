              <text column='[federated.187v7rn0gtp0m61ab2wqg09r272q].[usr:Calculation_0666616214384644:nk]' />
              <text column='[federated.187v7rn0gtp0m61ab2wqg09r272q].[usr:Calculation_0666616214519813:nk]' />
