          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Patient_Admissions_Data (hospital_final_dataset)' name='federated.187v7rn0gtp0m61ab2wqg09r272q' />
          </datasources>
          <datasource-dependencies datasource='federated.187v7rn0gtp0m61ab2wqg09r272q'>
            <column caption='Staff Allocation' datatype='integer' name='[Calculation_0814773887791104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Department_Name]&#13;&#10;    WHEN &apos;Surgery&apos; THEN 9&#13;&#10;    WHEN &apos;Emergency&apos; THEN 8&#13;&#10;    WHEN &apos;Pediatrics&apos; THEN 8&#13;&#10;    WHEN &apos;Internal Medicine&apos; THEN 7&#13;&#10;    WHEN &apos;Orthopedics&apos; THEN 8&#13;&#10;    WHEN &apos;ICU&apos; THEN 7&#13;&#10;    ELSE 8&#13;&#10;END' />
            </column>
            <column caption='DA_Avg_Workload_Dept' datatype='real' name='[Calculation_1507741882273795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [Department_Name] : COUNT([Patient_ID]) / MAX([Calculation_0814773887791104]) })' />
            </column>
            <column caption='Department Name' datatype='string' name='[Department_Name]' role='dimension' type='nominal' />
            <column caption='Patient ID' datatype='integer' name='[Patient_ID]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1507741882273795]' derivation='User' name='[usr:Calculation_1507741882273795:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
