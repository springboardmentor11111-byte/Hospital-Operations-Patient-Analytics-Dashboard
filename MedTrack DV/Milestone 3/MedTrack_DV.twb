            <column caption='Staff Allocation' datatype='integer' name='[Calculation_0814773887791104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Department_Name]&#13;&#10;    WHEN &apos;Surgery&apos; THEN 9&#13;&#10;    WHEN &apos;Emergency&apos; THEN 8&#13;&#10;    WHEN &apos;Pediatrics&apos; THEN 8&#13;&#10;    WHEN &apos;Internal Medicine&apos; THEN 7&#13;&#10;    WHEN &apos;Orthopedics&apos; THEN 8&#13;&#10;    WHEN &apos;ICU&apos; THEN 7&#13;&#10;    ELSE 8&#13;&#10;END' />
            </column>
            <column caption='CY_ALOS' datatype='real' name='[Calculation_1343912920281097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF YEAR([Admission_Date]) = {MAX(YEAR([Admission_Date]))} THEN [Length_of_Stay] END)' />
            </column>
            <column caption='CY_Occupancy_Rate' datatype='real' name='[Calculation_1343912937381907]' role='measure' type='quantitative'>
