            <column caption='RU_Bed_Capacity' datatype='integer' default-format='c#,##0' name='[Calculation_0356553675157505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Department_Name] : MAX(&#13;&#10;  CASE [Department_Name]&#13;&#10;  WHEN &quot;Surgery&quot; THEN 95&#13;&#10;  WHEN &quot;Emergency&quot; THEN 78&#13;&#10;  WHEN &quot;Pediatrics&quot; THEN 74&#13;&#10;  WHEN &quot;Internal Medicine&quot; THEN 68&#13;&#10;  WHEN &quot;Orthopedics&quot; THEN 52&#13;&#10;  WHEN &quot;ICU&quot; THEN 38&#13;&#10;  ELSE 0&#13;&#10;  END&#13;&#10;)}' />
