            <column caption='KPI_Growth_Inpatients' datatype='real' default-format='*▲ 0.0%;▼ 0.0%;0.0%' name='[Calculation_0424171832295424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(COUNT([Patient_ID])) - LOOKUP(ZN(COUNT([Patient_ID])), -1)) / ABS(LOOKUP(ZN(COUNT([Patient_ID])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Inpatient_Growth_Latest' datatype='real' default-format='*▲ 0.0%;▼ 0.0%;0.0%' name='[Calculation_0424171837980673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_MAX(IF LAST() = 0 THEN [Calculation_0424171832295424] END)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='KPI_Total_Inpatients' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0424171839041538]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='TOTAL(COUNT([Patient_ID]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
