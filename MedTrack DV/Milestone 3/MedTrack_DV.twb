    <worksheet name='RU_Bed_Capacity_vs_Occupied'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Book Antiqua' fontsize='9'>Total Bed Capacity vs. Avg Occupied Beds</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Patient_Admissions_Data (hospital_final_dataset)' name='federated.187v7rn0gtp0m61ab2wqg09r272q' />
          </datasources>
          <datasource-dependencies datasource='federated.187v7rn0gtp0m61ab2wqg09r272q'>
            <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
            <column caption='Bed Utilization Rate' datatype='real' name='[Bed_Utilization_Rate]' role='measure' type='quantitative' />
            <column caption='RU_Bed_Capacity' datatype='integer' default-format='c#,##0' name='[Calculation_0356553675157505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Department_Name] : MAX(&#13;&#10;  CASE [Department_Name]&#13;&#10;  WHEN &quot;Surgery&quot; THEN 95&#13;&#10;  WHEN &quot;Emergency&quot; THEN 78&#13;&#10;  WHEN &quot;Pediatrics&quot; THEN 74&#13;&#10;  WHEN &quot;Internal Medicine&quot; THEN 68&#13;&#10;  WHEN &quot;Orthopedics&quot; THEN 52&#13;&#10;  WHEN &quot;ICU&quot; THEN 38&#13;&#10;  ELSE 0&#13;&#10;  END&#13;&#10;)}' />
            </column>
            <column caption='RU_Avg_Occupied_Beds' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_0356553675374594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Department_Name] : MAX(&#13;&#10;  CASE [Department_Name]&#13;&#10;  WHEN &quot;Surgery&quot; THEN 65&#13;&#10;  WHEN &quot;Emergency&quot; THEN 55&#13;&#10;  WHEN &quot;Pediatrics&quot; THEN 44&#13;&#10;  WHEN &quot;Internal Medicine&quot; THEN 41&#13;&#10;  WHEN &quot;Orthopedics&quot; THEN 29&#13;&#10;  WHEN &quot;ICU&quot; THEN 30&#13;&#10;  ELSE 0&#13;&#10;  END&#13;&#10;)}' />
            </column>
            <column caption='KPI_Growth_Inpatients' datatype='real' default-format='*▲ 0.0%;▼ 0.0%;0.0%' name='[Calculation_0424171832295424]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(COUNT([Patient_ID])) - LOOKUP(ZN(COUNT([Patient_ID])), -1)) / ABS(LOOKUP(ZN(COUNT([Patient_ID])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Inpatient_Growth_Latest' datatype='real' default-format='*▲ 0.0%;▼ 0.0%;0.0%' name='[Calculation_0424171837980673]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_MAX(IF LAST() = 0 THEN [Calculation_0424171832295424] END)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='KPI_Avg_Length_of_Stay' datatype='real' default-format='n#,##0.00&quot; Days&quot;;-#,##0.00&quot; Days&quot;' name='[Calculation_0424171847860228]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='WINDOW_AVG(AVG([Length_of_Stay]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Staff Allocation' datatype='integer' name='[Calculation_0814773887791104]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Department_Name]&#13;&#10;    WHEN &apos;Surgery&apos; THEN 9&#13;&#10;    WHEN &apos;Emergency&apos; THEN 8&#13;&#10;    WHEN &apos;Pediatrics&apos; THEN 8&#13;&#10;    WHEN &apos;Internal Medicine&apos; THEN 7&#13;&#10;    WHEN &apos;Orthopedics&apos; THEN 8&#13;&#10;    WHEN &apos;ICU&apos; THEN 7&#13;&#10;    ELSE 8&#13;&#10;END' />
            </column>
            <column caption='CY_Admissions' datatype='integer' name='[Calculation_1343912913166340]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(IF YEAR([Admission_Date]) = {MAX(YEAR([Admission_Date]))} THEN [Patient_ID] END)' />
            </column>
            <column caption='CY_Readmission_Rate' datatype='real' name='[Calculation_1343912925093902]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF YEAR([Admission_Date]) = {MAX(YEAR([Admission_Date]))} THEN [Readmission_Rate_%] END)' />
            </column>
            <column caption='CY_Occupancy_Rate' datatype='real' name='[Calculation_1343912937381907]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF YEAR([Admission_Date]) = {MAX(YEAR([Admission_Date]))} THEN [Dept_Occupancy_Rate] END)' />
            </column>
            <column caption='CY_Bed_Utilization' datatype='real' name='[Calculation_1343912938962968]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF YEAR([Admission_Date]) = {MAX(YEAR([Admission_Date]))} THEN [Bed_Utilization_Rate] END)' />
            </column>
            <column caption='DA_Avg_Workload_Dept' datatype='real' name='[Calculation_1507741882273795]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG({ FIXED [Department_Name] : COUNT([Patient_ID]) / MAX([Calculation_0814773887791104]) })' />
            </column>
            <column caption='Department Efficiency Score' datatype='real' name='[Department_Efficiency_Score]' role='measure' type='quantitative' />
            <column caption='Department Name' datatype='string' name='[Department_Name]' role='dimension' type='nominal' />
            <column caption='Dept Occupancy Rate' datatype='real' name='[Dept_Occupancy_Rate]' role='measure' type='quantitative' />
            <column caption='Length of Stay' datatype='integer' name='[Length_of_Stay]' role='measure' type='quantitative' />
            <column caption='Patient ID' datatype='integer' name='[Patient_ID]' role='dimension' type='ordinal' />
            <column caption='Readmission Rate %' datatype='real' name='[Readmission_Rate_%]' role='measure' type='quantitative' />
            <column-instance column='[Department_Name]' derivation='None' name='[none:Department_Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0356553675157505]' derivation='Sum' name='[sum:Calculation_0356553675157505:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0356553675374594]' derivation='Sum' name='[sum:Calculation_0356553675374594:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Department_Efficiency_Score]' derivation='Sum' name='[sum:Department_Efficiency_Score:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Dept_Occupancy_Rate]' derivation='Sum' name='[sum:Dept_Occupancy_Rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0424171837980673]' derivation='User' name='[usr:Calculation_0424171837980673:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' />
