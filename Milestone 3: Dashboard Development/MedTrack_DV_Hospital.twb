      <column caption='Occupancy Rate' datatype='real' name='[Calculation_0342253578002432]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Bed Status] = &quot;Occupied&quot; THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([Bed Status])&#13;&#10;*100' />
      </column>
      <column caption='Readmission Rate' datatype='real' name='[Calculation_0342253582655489]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Re-admission Flag] = &quot;Yes&quot; THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([Patient ID])&#13;&#10;*100' />
