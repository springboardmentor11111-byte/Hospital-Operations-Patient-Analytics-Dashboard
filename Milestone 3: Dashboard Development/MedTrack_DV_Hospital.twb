          <calculation class='tableau' formula='SUM(&#13;&#10;IF [Re-admission Flag] = &quot;Yes&quot; THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([Patient ID])&#13;&#10;*100' />
