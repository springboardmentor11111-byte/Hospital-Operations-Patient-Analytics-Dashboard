        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Bed Status] = &quot;Occupied&quot; THEN 1&#13;&#10;ELSE 0&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([Bed Status])&#13;&#10;*100' />
