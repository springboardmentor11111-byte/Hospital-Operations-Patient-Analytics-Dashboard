      <column caption='Calculated Occupancy Rate' datatype='real' name='[Calculated_Occupancy_Rate]' role='measure' type='quantitative' />
      <column caption='KPI: Total Admissions' datatype='integer' name='[Calculation_1930779687895040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Patient_ID])' />
      </column>
      <column caption='KPI: Occupancy Rate' datatype='real' name='[Calculation_1930779690369025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(([Occupied_Beds_At_Admission] / [Total_Beds_In_Department]) * 100)' />
      </column>
      <column caption='KPI: Average Length of Stay' datatype='real' name='[Calculation_1930779690491906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Length_of_Stay_Days])' />
      </column>
      <column caption='KPI: Readmission Rate' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[Calculation_1930779690651651]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM(IF [Readmission_Flag] = &quot;Yes&quot; THEN 1 ELSE 0 END) / COUNTD([Patient_ID])) * 100' />
      </column>
      <column caption='KPI: Bed Utilization Rate' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[Calculation_1930779690766340]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Bed_Utilization_Rate_Pct])' />
      </column>
      <column caption='KPI: Department Efficiency Score' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[Calculation_1930779690889221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Department_Efficiency_Score])' />
      </column>
